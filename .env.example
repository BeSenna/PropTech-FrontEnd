# Variáveis do frontend. NÃO há segredos aqui (NEXT_PUBLIC_* vão para o navegador), então o frontend não usa Infisical.
# Em produção quem define as variáveis é o Jenkinsfile (bloco environment). Não commitar .env.local.
# NEXT_PUBLIC_* são lidas NO BUILD: depois de mudar, rode o build/`docker compose up --build` de novo.

# Subcaminho onde o site é publicado (http://academico3.rj.senac.br/condominio). Em desenvolvimento deixe VAZIO; em produção (Jenkins) é /condominio.
NEXT_PUBLIC_BASE_PATH=

# Base da API do MS Moradores, vista pelo NAVEGADOR (passando pelo gateway).
# Gateway público: http://academico3.rj.senac.br/condominio/gateway  → rota do MS Moradores: /morador
# (caminho relativo: o site e o gateway estão no mesmo host, então não há CORS)
NEXT_PUBLIC_API_URL=/condominio/gateway/morador

# Só para `npm run dev`: o Next encaminha NEXT_PUBLIC_API_URL/* para o MS local (porta 7522), simulando o gateway.
API_PROXY_TARGET=http://localhost:7522
